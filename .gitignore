# FactoryForge .gitignore

# Godot engine build outputs & mono temp files
.godot/
engine/.godot/
*.import

# .NET build outputs
bin/
obj/
*.user
*.suo
*.userosset
*.sln.docstates

# Python bytecode & caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
*.egg-info/
build/
dist/

# Temporary screenshots & logs. Working screenshots land in the repo root and
# are throwaway; anything under docs/images/ is documentation and belongs in
# the repo, so it is exempted rather than force-added case by case.
*.png
!docs/images/**/*.png
*.log
scratch/

# test_plan.py engine output
.test_plan_engine.log
